{
  "name": "kodex-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, local-first AI coding IDE with an autonomous Kodex agent",
  "author": "Aayush Datta",
  "license": "MIT",
  "homepage": "https://github.com/fireyhellmarketing-cmd/kodex",
  "repository": {
    "type": "git",
    "url": "https://github.com/fireyhellmarketing-cmd/kodex.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "env -u ELECTRON_RUN_AS_NODE node ../../node_modules/electron/cli.js electron/main.cjs",
    "native:rebuild": "electron-rebuild -f -w node-pty -m .",
    "test:terminal": "node --test electron/terminal-manager.test.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "lint": "eslint .",
    "core:bundle": "node ../../scripts/build-core.cjs",
    "package": "npm run build && npm run core:bundle && electron-builder --publish never",
    "package:mac": "npm run build && npm run core:bundle && electron-builder --mac --publish never",
    "package:win": "npm run build && npm run core:bundle && electron-builder --win --publish never",
    "package:linux": "npm run build && npm run core:bundle && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.1",
    "electron": "42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "dev.kodex.desktop",
    "productName": "Kodex",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core/dist",
        "to": "core",
        "filter": [
          "kodex-core*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/kodex-icon.png",
      "hardenedRuntime": true,
      "entitlements": "../../packaging/entitlements.mac.plist",
      "entitlementsInherit": "../../packaging/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "electron/kodex-icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "electron/kodex-icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
